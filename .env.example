# Copy to .env (next to docker-compose.yml) and fill in what you want.

TZ=America/Detroit

# Where nightly backups are written on the host. Point your copy-to-Dropbox
# batch file at this folder. (Windows paths work, e.g. C:/Docker/MyLib/backups)
BACKUP_PATH=./backups
BACKUP_CRON=0 2 * * *
BACKUP_KEEP_DAYS=30

# Optional book data sources (Open Library is always used and needs no key)
# Free key: https://console.cloud.google.com → enable "Books API" → Credentials → API key
GOOGLE_BOOKS_API_KEY=
# Paid: https://isbndb.com
ISBNDB_API_KEY=

# Optional: lets MyLib identify books from cover photos with Claude.
# Key from https://console.anthropic.com
ANTHROPIC_API_KEY=
