# Copy to .env (next to docker-compose.yml) and fill in what you want.

TZ=America/Detroit

# Where nightly backups are written on the host. Point your copy-to-Dropbox
# batch file at this folder. (Windows paths work, e.g. C:/Docker/MyLib/backups)
BACKUP_PATH=./backups
BACKUP_CRON=0 2 * * *
BACKUP_KEEP_DAYS=30

# Optional book data sources (Open Library is always used and needs no key)
# Free key: https://console.cloud.google.com → enable "Books API" → Credentials → API key
GOOGLE_BOOKS_API_KEY=
# Free token: hardcover.app → Settings → Hardcover API → New API Key
HARDCOVER_API_TOKEN=
# Paid: https://isbndb.com
ISBNDB_API_KEY=
# Free key: https://developer.nytimes.com (enable the Books API). Only used to mark NYT bestsellers.
NYT_API_KEY=

# MyLib stops calling a source for the rest of the day at these limits (0 = no limit).
# The order sources are asked in is set on the Book sources page.
GOOGLE_BOOKS_DAILY_LIMIT=1000
HARDCOVER_DAILY_LIMIT=5000
NYT_DAILY_LIMIT=1000
ISBNDB_DAILY_LIMIT=0

# Optional: lets MyLib identify books from cover photos with Claude.
# Key from https://console.anthropic.com
ANTHROPIC_API_KEY=
